# Normalise line endings. The GitHub Actions runners are Linux, and a
# CRLF slipping into a shell step fails in ways that are annoying to
# diagnose, so text is stored as LF regardless of who commits.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.ico binary
*.woff  binary
*.woff2 binary
*.apk binary
*.keystore binary
